# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but keep the documented example committed
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor / OS
.vscode/
.idea/
Thumbs.db

# test artifacts
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
.eslintcache

# locally-stored uploaded media — public images + private gated media
/public/uploads/
/private-uploads/

# extra
/.playwright-mcp/
/.docs/
# Local dev server log (from manual restarts)
.next-dev.log
