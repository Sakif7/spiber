# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but keep the documented example committed
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor / OS
.vscode/
.idea/
Thumbs.db

# test suite + configs (solo project — run locally, not needed in the repo or the
# Coolify build; note: `next build` still needs eslint.config.mjs + tsconfig.json)
/tests/
/e2e/
/playwright.config.ts
/vitest.config.ts

# test artifacts
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
.eslintcache

# locally-stored uploaded media — public images + private gated media
/public/uploads/
/private-uploads/
# local data dir (when UPLOADS_DIR / PRIVATE_UPLOADS_DIR point at ./data)
/data/
# staged brand logos for the bulk brand-logo tooling (review folder, not source)
/brand-logos/

# local-only sample data for screenshots/QA (not for production)
/scripts/demo-seed.mjs

# Claude assistant memory (local notes; durable facts live in CLAUDE.md)
/memory/

# extra
/.playwright-mcp/
/.docs/
/.agents/
/.claude/
# Local dev server log (from manual restarts)
.next-dev.log
.patchtmp/

# Rendered PDF previews (npm run pdf-preview)
/public/_preview/

# /brag launch-video output (video, composition, plan) - never committed
brag-output/
