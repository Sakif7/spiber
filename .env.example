# ─────────────────────────────────────────────────────────────
# Spiber Med — environment variables
# Copy to .env.local for local dev; set the real values in the
# Coolify UI for production. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

# Core
NODE_ENV=development
APP_URL=http://localhost:3000
JWT_SECRET=
JWT_REFRESH_SECRET=
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,bn
CURRENCY=BDT

# Bootstrap: comma-separated emails granted super_admin on registration
SUPER_ADMIN_EMAILS=

# Database (existing Coolify Mongo)
MONGODB_URI=
MONGODB_DB=spiber

# Cloudflare R2 (S3-compatible storage) — used from Phase 1
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Cloudflare Stream (video) — used from Phase 2
CF_STREAM_ACCOUNT_ID=
CF_STREAM_API_TOKEN=
CF_STREAM_SIGNING_KEY=

# Payments (pluggable; default = manual/offline)
PAYMENT_PROVIDER=manual        # manual | sslcommerz | aamarpay | stripe
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
AAMARPAY_STORE_ID=
AAMARPAY_SIGNATURE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (pluggable; default = console in dev). For Hostinger business email,
# set EMAIL_PROVIDER=smtp and the SMTP_* vars below (no Resend needed).
EMAIL_PROVIDER=console         # console | smtp
SMTP_HOST=                     # e.g. smtp.hostinger.com
SMTP_PORT=465                  # 465 (SSL) or 587 (STARTTLS)
SMTP_SECURE=                   # blank = auto (true on 465); set true/false to override
SMTP_USER=                     # full mailbox, e.g. noreply@spibermed.com
SMTP_PASS=
EMAIL_FROM=                    # e.g. "Spiber Med <noreply@spibermed.com>"

# Flights / air ticket (pluggable; default = manual/request) — used from Phase 4
FLIGHT_PROVIDER=manual         # manual | amadeus | travelport
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
