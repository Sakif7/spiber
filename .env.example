# Spiber Med — env template. Copy to .env.local for dev; set real values in Coolify for prod.

# ── Core ──
NODE_ENV=development           # development | production
APP_URL=http://localhost:3000  # public base URL (email links, OG, sitemap)
JWT_SECRET=                    # access-token secret — REQUIRED in prod (openssl rand -base64 48)
JWT_REFRESH_SECRET=            # refresh-token secret — REQUIRED in prod (must differ from JWT_SECRET)
SUPER_ADMIN_EMAILS=            # comma-separated emails auto-promoted to super_admin
# Locale (en, bn) and currency (BDT) are fixed in code (i18n/routing.ts) — no env needed.

# ── Database (existing Coolify Mongo) ──
MONGODB_URI=                   # Mongo connection string — REQUIRED
MONGODB_DB=spiber              # database name

# ── Storage (R2, or local disk) ──
R2_ACCOUNT_ID=                 # Cloudflare R2 account id
R2_ACCESS_KEY_ID=              # R2 access key
R2_SECRET_ACCESS_KEY=          # R2 secret key
R2_BUCKET=                     # R2 bucket for public images
R2_PUBLIC_BASE_URL=            # public base URL for R2 objects
R2_PRIVATE_BUCKET=             # optional R2 bucket for gated media (falls back to R2_BUCKET)
ALLOW_LOCAL_STORAGE=           # set true to allow local-disk storage in production
UPLOADS_DIR=                   # abs path for PUBLIC images on local storage (default <cwd>/public/uploads). Mount a persistent volume here in prod.
PRIVATE_UPLOADS_DIR=           # abs path for gated media on local storage (default <cwd>/private-uploads). Mount a persistent volume here in prod.

# ── Video (Cloudflare Stream; blank = local file playback via gated route) ──
CF_STREAM_ACCOUNT_ID=          # Stream account id
CF_STREAM_API_TOKEN=           # Stream API token
CF_STREAM_SIGNING_KEY=         # Stream signing key (PKCS8 PEM) for signed playback
CF_STREAM_SIGNING_KEY_ID=      # Stream signing key id

# ── Spiber Digihealth (external provisioning, e.g. ZenHcare) ──
SYSTEMS_PROVISION_PROVIDER=manual  # manual | <future automated provider>
ZENHCARE_ADMIN_EMAIL=              # external-app admin notified to activate users
ZENHCARE_API_BASE=                 # ZenHcare API base (default https://api.zenhcare.com)
ZENHCARE_AFFILIATE_API_KEY=        # ZenHcare affiliate API key (aff_live_*) — server-only secret; forwards product inquiries as attributed leads

# ── Payments (pluggable; default manual/offline) ──
# Only "manual" and "dev" are implemented. An unimplemented name now THROWS
# rather than falling back, because a silent fallback would take orders through
# a checkout that charges nobody. "dev" is the sandbox gateway and refuses to
# run in production.
PAYMENT_PROVIDER=manual        # manual | dev | sslcommerz | aamarpay | stripe
DEV_PAYMENT_SECRET=            # sandbox callback signing key (dev only; has a default)
SSLCOMMERZ_STORE_ID=           # SSLCommerz store id
SSLCOMMERZ_STORE_PASSWORD=     # SSLCommerz store password
AAMARPAY_STORE_ID=             # AamarPay store id
AAMARPAY_SIGNATURE_KEY=        # AamarPay signature key
STRIPE_SECRET_KEY=             # Stripe secret key
STRIPE_WEBHOOK_SECRET=         # Stripe webhook signing secret

# ── Email (pluggable; default console in dev) ──
EMAIL_PROVIDER=console         # console | smtp
SMTP_HOST=                     # e.g. smtp.hostinger.com
SMTP_PORT=465                  # 465 (SSL) or 587 (STARTTLS)
SMTP_SECURE=                   # blank = auto (true on 465)
SMTP_USER=                     # full mailbox, e.g. noreply@spibermed.com
SMTP_PASS=                     # mailbox password
EMAIL_FROM=                    # e.g. "Spiber Med <noreply@spibermed.com>"

# ── Spiber Tourism (manual-first; all request flows default to manual) ──
TOURISM_TEAM_EMAIL=            # case-manager inbox for case/appointment/travel/partner notifications (falls back to CONTACT_TEAM_EMAIL → info@)
FLIGHT_PROVIDER=manual         # manual | amadeus | travelport
HOTEL_PROVIDER=manual          # manual | <future hotel API>
VISA_PROVIDER=manual           # manual | <future visa API>
TRANSFER_PROVIDER=manual       # manual | <future transfer API>
AMADEUS_CLIENT_ID=             # Amadeus client id
AMADEUS_CLIENT_SECRET=         # Amadeus client secret

# ── OAuth (optional) ──
GOOGLE_CLIENT_ID=              # Google OAuth client id
GOOGLE_CLIENT_SECRET=          # Google OAuth client secret

# ── Chat assistant (pluggable; default heuristic, no API key needed) ──
CHAT_PROVIDER=heuristic        # heuristic (default, no LLM) | llm (Claude, needs ANTHROPIC_API_KEY)
CHAT_TEAM_EMAIL=               # inbox for chatbot lead notifications (falls back to CONTACT_TEAM_EMAIL → info@)
ANTHROPIC_API_KEY=            # only for CHAT_PROVIDER=llm (falls back to heuristic if unset)
CHAT_LLM_MODEL=claude-opus-4-8 # model id used when CHAT_PROVIDER=llm

# ── Company document vault (super-admin only; encrypted at rest) ──
COMPANY_VAULT_KEY=             # 64 hex chars (32 bytes) — node -e "console.log(require('crypto').randomBytes(32).toString('hex'))". Losing it loses the stored files.

# ── Inventory alerts ──
INVENTORY_TEAM_EMAIL=          # inbox for the daily low-stock digest (falls back to CONTACT_TEAM_EMAIL → info@)
# Shared secret for scheduled jobs, sent as "Authorization: Bearer <CRON_SECRET>".
#   /api/cron/low-stock-digest   once a day
#   /api/cron/expire-payments    every few minutes ONCE ONLINE PAYMENT IS ON.
#     Without it, every abandoned online checkout keeps its reserved stock for
#     good, so this schedule is not optional.
CRON_SECRET=
