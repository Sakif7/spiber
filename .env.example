# ─────────────────────────────────────────────────────────────
# Spiber Med — environment variables
# Copy to .env.local for local dev; set the real values in the
# Coolify UI for production. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

# Core
NODE_ENV=development
APP_URL=http://localhost:3000
JWT_SECRET=
JWT_REFRESH_SECRET=
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,bn
CURRENCY=BDT

# Bootstrap: comma-separated emails granted super_admin on registration
SUPER_ADMIN_EMAILS=

# Database (existing Coolify Mongo)
MONGODB_URI=
MONGODB_DB=spiber

# Cloudflare R2 (S3-compatible storage) — used from Phase 1.
# REQUIRED in production: without these, uploads fall back to local disk, which
# is ephemeral in the standalone container (lost on redeploy) — so the app now
# REFUSES the disk fallback in production unless ALLOW_LOCAL_STORAGE=true.
# Recommended: use a PRIVATE bucket for protected media (course videos/resources,
# software assets) so objects are only reachable through the auth-gated /api/media
# routes; serve public images from R2_PUBLIC_BASE_URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
# Set true only for a self-hosted prod using local-disk storage. REQUIRES two
# persistent volumes so uploads survive redeploys:
#   • public images  → <app>/public/uploads   (served at /uploads/<key>)
#   • private/gated media (course video/PDF, software assets) → the private dir
#     below, which is OUTSIDE public/ so it's NEVER served statically — only via
#     the auth-gated /api/media routes.
ALLOW_LOCAL_STORAGE=
# Absolute path for private/gated media. Defaults to <cwd>/private-uploads.
# Mount a persistent volume here in production.
PRIVATE_UPLOADS_DIR=
# Optional dedicated R2 bucket for private/gated media (keeps it off the public
# base URL). Falls back to R2_BUCKET if unset. Only relevant when using R2.
R2_PRIVATE_BUCKET=

# Cloudflare Stream (video) — used from Phase 2.
# When ACCOUNT_ID + API_TOKEN are set, the VideoProvider uses Cloudflare Stream
# (signed adaptive playback); otherwise it falls back to local/R2 file playback
# so the LMS works without a Stream account. SIGNING_KEY (PKCS8 PEM, raw or
# base64) + SIGNING_KEY_ID enable signed/tokenized playback URLs.
CF_STREAM_ACCOUNT_ID=
CF_STREAM_API_TOKEN=
CF_STREAM_SIGNING_KEY=
CF_STREAM_SIGNING_KEY_ID=

# Spiber Systems — external-app provisioning (e.g. ZenHcare). Buying an
# external-delivery product creates a provisioning task + accrues an affiliate
# commission, then emails this address to activate the user. The provider is
# pluggable: `manual` (default) notifies by email; an automated provider can be
# added later without changing the purchase flow.
SYSTEMS_PROVISION_PROVIDER=manual   # manual | <future automated provider>
ZENHCARE_ADMIN_EMAIL=

# Payments (pluggable; default = manual/offline)
PAYMENT_PROVIDER=manual        # manual | sslcommerz | aamarpay | stripe
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
AAMARPAY_STORE_ID=
AAMARPAY_SIGNATURE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (pluggable; default = console in dev). For Hostinger business email,
# set EMAIL_PROVIDER=smtp and the SMTP_* vars below (no Resend needed).
EMAIL_PROVIDER=console         # console | smtp
SMTP_HOST=                     # e.g. smtp.hostinger.com
SMTP_PORT=465                  # 465 (SSL) or 587 (STARTTLS)
SMTP_SECURE=                   # blank = auto (true on 465); set true/false to override
SMTP_USER=                     # full mailbox, e.g. noreply@spibermed.com
SMTP_PASS=
EMAIL_FROM=                    # e.g. "Spiber Med <noreply@spibermed.com>"

# Flights / air ticket (pluggable; default = manual/request) — used from Phase 4
FLIGHT_PROVIDER=manual         # manual | amadeus | travelport
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
